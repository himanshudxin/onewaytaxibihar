{
  "name": "onewaytaxibihar-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start apps/passenger --port 8081 --lan",
    "start:passenger": "expo start apps/passenger --port 8081 --lan",
    "start:driver": "expo start apps/driver --port 8082 --lan",
    "start:admin": "expo start apps/admin --port 8083 --lan",
    "build:passenger:apk": "eas build -p android --profile preview --config apps/passenger/app.json",
    "build:passenger:aab": "eas build -p android --profile production --config apps/passenger/app.json",
    "build:driver:apk": "eas build -p android --profile preview --config apps/driver/app.json",
    "build:driver:aab": "eas build -p android --profile production --config apps/driver/app.json",
    "build:admin:apk": "eas build -p android --profile preview --config apps/admin/app.json",
    "build:admin:aab": "eas build -p android --profile production --config apps/admin/app.json",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "expo": "^58.0.0",
    "expo-asset": "~58.0.18",
    "expo-constants": "~58.0.13",
    "expo-haptics": "~58.0.7",
    "expo-linear-gradient": "~58.0.3",
    "expo-location": "~58.0.19",
    "expo-status-bar": "~58.0.4",
    "lucide-react-native": "^0.475.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-webview": "^14.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
