{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../../shared/*"],
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src",
    "../../declarations.d.ts"
  ],
  "exclude": [
