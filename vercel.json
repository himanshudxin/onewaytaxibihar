{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/health", "destination": "/api/health" },
    { "source": "/api/bookings", "destination": "/api/bookings" },
    { "source": "/api/admin/leads(.*)", "destination": "/api/leads" },
    { "source": "/api/leads(.*)", "destination": "/api/leads" },
    { "source": "/api/auth/(.*)", "destination": "/api/auth" },
    { "source": "/api/admin/(.*)", "destination": "/api/admin" },
    { "source": "/api/auth", "destination": "/api/auth" },
    { "source": "/api/admin", "destination": "/api/admin" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/driver", "destination": "/driver.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS, PATCH" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Requested-With" }
      ]
    }
  ]
}
