# ===================================================================
# Oneway Taxi & Oneway Taxi Driver Mobile Apps
# Environment Configuration Template (.env.example)
# ===================================================================
# SAFE TEMPLATE: CONTAINS PLACEHOLDERS ONLY. NEVER PUT REAL SECRETS HERE.
# Copy this file to `mobile/.env` for local mobile testing.
# React Native / Expo automatically exposes variables prefixed with EXPO_PUBLIC_

# -------------------------------------------------------------
# 1. BACKEND REST API ENDPOINT
# -------------------------------------------------------------
# Local development on LAN: http://<your-lan-ip>:8080/api (e.g., http://192.168.1.15:8080/api)
# Production Cloud Gateway: https://onewaytaxibihar.com/api
EXPO_PUBLIC_API_URL=https://onewaytaxibihar.com/api

# -------------------------------------------------------------
# 2. GOOGLE MAPS & ROUTING SDK
# -------------------------------------------------------------
# Web & Mobile Client API Key with Maps SDK for Android & iOS enabled
# Restrict this key by Android Package Name & iOS Bundle ID in Google Cloud Console
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy_YOUR_RESTRICTED_GOOGLE_MAPS_KEY_HERE

# -------------------------------------------------------------
# 3. RAZORPAY PAYMENT GATEWAY (CLIENT-SIDE KEY ONLY)
# -------------------------------------------------------------
# Only the public Key ID (rzp_test_... or rzp_live_...) is safe on mobile.
# NEVER put the Razorpay Key Secret in mobile applications.
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_PUBLIC_KEY_ID

# -------------------------------------------------------------
# 4. CUSTOMER CARE & HELPLINES (BIHAR & EAST INDIA)
# -------------------------------------------------------------
EXPO_PUBLIC_SUPPORT_PHONE=+918002141816
EXPO_PUBLIC_SUPPORT_WHATSAPP=+916206494214
EXPO_PUBLIC_FLEET_DESK_PHONE=+916206494214
EXPO_PUBLIC_SOS_NUMBER=112

# -------------------------------------------------------------
# 5. ERROR MONITORING & TELEMETRY (OPTIONAL)
# -------------------------------------------------------------
# Sentry DSN for crash reporting across iOS and Android
EXPO_PUBLIC_SENTRY_DSN=https://example_public_key@sentry.io/project_id
