{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/health", "destination": "/api/health.js" },
    { "source": "/api/bookings", "destination": "/api/bookings.js" },
    { "source": "/api/leads", "destination": "/api/leads.js" },
    { "source": "/api/auth/:path*", "destination": "/api/auth/[...all].js" },
    { "source": "/api/admin/:path*", "destination": "/api/admin/[...all].js" },
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/driver", "destination": "/driver.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS, PATCH" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Requested-With" }
      ]
    }
  ]
}
